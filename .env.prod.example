# The server's .env, beside compose.prod.yml (docs/deployment.md). Stand-in values:
# the real domain and secrets live only in the server's copy (chmod 600).
# Compose interpolates `$` in this file: keep secrets to [A-Za-z0-9+/=] (openssl rand).

# A bare `docker compose …` in this directory uses the production file.
COMPOSE_FILE=compose.prod.yml

# The images and the version running: `sha-<commit>` of a commit CI built.
JSC_IMAGES=ghcr.io/example
JSC_TAG=sha-0000000000000000000000000000000000000000

# The project's own role and database in the shared Postgres (the infra repo's README).
DATABASE_URL=postgresql://jsc:replace-me@postgres:5432/jsc

# One origin: the web at /, the API at /api and /.well-known (Caddy routes them).
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
BETTER_AUTH_URL=https://jsc.example.com
WEB_ORIGIN=https://jsc.example.com
# OAuth clients, redirect URIs https://jsc.example.com/api/auth/callback/{google,linkedin}.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
LINKEDIN_CLIENT_ID=replace-me
LINKEDIN_CLIENT_SECRET=replace-me
AUTH_ALLOWED_EMAILS=you@example.com
# Baked into every passkey: changing it voids them all.
PASSKEY_RP_ID=jsc.example.com

# The MCP server's URL as claude.ai calls it: the API issues tokens for it.
MCP_PUBLIC_URL=https://jsc-mcp.example.com/mcp
