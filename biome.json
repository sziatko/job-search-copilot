{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/*.d.ts",
      "!packages/core/prisma/migrations",
      "!apps/web/dist",
      "!docs/design",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/**", "apps/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@prisma/*", "pg", "pg/*"],
                    "message": "packages/core is the only database client (docs/architecture.md § System invariants, 1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@job-search-copilot/core", "@job-search-copilot/core/*"],
                    "message": "The web app's API contract is a hand-written zod schema, not a core import (docs/architecture.md § System invariants, 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/pages/**", "../*/**"],
                    "message": "A page imports only from its own folder, components/ and lib/ (docs/architecture.md § Inside apps/web/src)."
                  },
                  {
                    "group": ["@job-search-copilot/core", "@job-search-copilot/core/*"],
                    "message": "The web app's API contract is a hand-written zod schema, not a core import (docs/architecture.md § System invariants, 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/**", "apps/web/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/pages/**"],
                    "message": "components/ and lib/ never import a page (docs/architecture.md § Inside apps/web/src)."
                  },
                  {
                    "group": ["@job-search-copilot/core", "@job-search-copilot/core/*"],
                    "message": "The web app's API contract is a hand-written zod schema, not a core import (docs/architecture.md § System invariants, 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/index.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
