# Used by docker-compose to initialize the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_search_copilot

# Used by Prisma CLI / apps when running directly on the host (outside Docker).
# Containers get their own DATABASE_URL (pointing at the "postgres" service) via docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_search_copilot

API_PORT=3000

# --- Auth (phase 6, ADR-0034) ---
# Signs session cookies; at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
# The API's public origin; OAuth callbacks are built from it.
BETTER_AUTH_URL=http://localhost:3000
# The web's origin, exactly (no trailing slash): the CORS allowlist and Better Auth's
# trustedOrigins. A mismatch fails every sign-in.
WEB_ORIGIN=http://localhost:5173
# OAuth clients, redirect URIs http://localhost:3000/api/auth/callback/{google,linkedin}.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
LINKEDIN_CLIENT_ID=replace-me
LINKEDIN_CLIENT_SECRET=replace-me
# Comma-separated: the only emails that may sign up.
AUTH_ALLOWED_EMAILS=you@example.com
# The passkeys' relying party id; baked into every stored passkey.
PASSKEY_RP_ID=localhost
# The stdio MCP (apps/mcp/src/index.ts, npm run dev) acts as this key's owner (ADR-0039):
# create one on /profile. In Docker `.env` reaches the `mcp` container; Claude Desktop's
# stdio config runs `docker exec`, so its own `env` reaches the container only with
# `-e JSC_API_KEY` among the exec arguments.
# JSC_API_KEY=jsc_replace-me
# The MCP server's URL exactly as MCP clients call it (ADR-0035): the API issues tokens
# for it (their audience), the MCP HTTP server checks it. A mismatch refuses every token.
MCP_PUBLIC_URL=http://localhost:3001/mcp
# MCP over HTTP (apps/mcp/src/http.ts): its port, and where it fetches the API's JWKS
# (`npm run dev:mcp:http` on the host; docker-compose sets http://api:3000 itself).
MCP_HTTP_PORT=3001
AUTH_URL=http://localhost:3000

# `npm run db:pull` (docs/deployment.md): the server it dumps the production DB from.
# PROD_SSH=user@host
