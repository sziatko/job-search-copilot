# Playwright (npm run test:e2e): cp .env.e2e.example .env.e2e. Fake values, as in CI.
# Its own database and ports (:3100, :5174), so it runs beside the dev stack.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_search_copilot_e2e
BETTER_AUTH_SECRET=e2e-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3100
WEB_ORIGIN=http://localhost:5174
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret
LINKEDIN_CLIENT_ID=e2e-linkedin-client-id
LINKEDIN_CLIENT_SECRET=e2e-linkedin-client-secret
AUTH_ALLOWED_EMAILS=me@example.com
PASSKEY_RP_ID=localhost
MCP_PUBLIC_URL=http://localhost:3001/mcp
