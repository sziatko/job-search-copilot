generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // company is only ever queried as ILIKE '%term%' (see VacancyService.list),
  // which a plain b-tree index can't serve — pg_trgm + a GIN index below can.
  extensions = [pg_trgm]
}

model Vacancy {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  company             String
  title               String
  applyUrl            String          @unique
  // Intake's second match (ADR-0033): normalizeCompanyKey / normalizeTitleKey
  // (vacancy-intake.ts) — not vacancy.service's `companyKey()`, ADR-0032's company
  // identity. Null only when the name normalizes to nothing (`—`).
  companyKey          String?
  titleKey            String?
  // Where intake found it (`justjoin`, `linkedin`, …). Free text, so a new source
  // needs no migration; null on rows from save_vacancy, record_application, the log.
  source              String?
  // Null = no posting text yet. Can be large. Kept on the row rather than a 1:1 side
  // table on purpose: Postgres TOASTs large TEXT out-of-line, and every read path
  // except getById projects it out (see LIST_SELECT).
  fullText            String?         @db.Text
  // The analysis: both null = not analysed yet, both set = analysed, written once.
  // Hand-written CHECKs (20261003130100): both or neither, and never on a NEW row.
  matchScore          Int?
  recommendation      Recommendation?
  // The user's side: a cache of the latest StatusChange and its date. Written only
  // through writeStatus (status.ts), which keeps the two in step.
  status              VacancyStatus   @default(NEW)
  statusChangedAt     DateTime        @default(now())
  // What was entered when applying (the apply modal).
  salaryInApplication String?
  usedTailoredResume  Boolean         @default(false)

  // Every note on the vacancy — the analyzer's reasoning, the user's, an agent's.
  comments            Comment[]
  // Every status the vacancy has been in, with its date.
  statusChanges       StatusChange[]

  @@index([recommendation])
  @@index([status, statusChangedAt])
  @@index([companyKey, titleKey])
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  // /applications searches company OR title as ILIKE '%term%' — same reason company has
  // a trigram GIN index, title needs one too.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// One row per status change, append-only. The applied date is the latest APPLIED row's
// createdAt.
model StatusChange {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  status    VacancyStatus
  vacancyId Int
  vacancy   Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, createdAt])
}

// One note on a vacancy, append-only: no edit, no delete. `source` says who wrote it —
// the analyzer's reasoning (written once, with the analysis), the user's, or an agent's
// (MCP). Read oldest first, `id` breaking a tie.
model Comment {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  body      String        @db.Text
  source    CommentSource
  vacancyId Int
  vacancy   Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, createdAt])
}

enum Recommendation {
  APPLY
  APPLY_WITH_CAVEATS
  SKIP
}

enum CommentSource {
  ANALYZER
  USER
  AGENT
}

// Triage (NEW, NOT_REVIEWED, SAVED_FOR_LATER, DECLINED, UNAVAILABLE, FILTERED_OUT), then
// the pipeline (APPLIED … REJECTED — PIPELINE_STATUSES). NEW = waiting for analysis;
// FILTERED_OUT = screened out before triage, by the analyzer's SKIP or the user (ADR-0033).
// REJECTED = the company said no; DECLINED = "I chose not to apply"; UNAVAILABLE = the
// posting no longer takes applications.
enum VacancyStatus {
  NEW
  NOT_REVIEWED
  SAVED_FOR_LATER
  DECLINED
  UNAVAILABLE
  FILTERED_OUT
  APPLIED
  RECRUITER_SCREEN
  REPLIED
  INTERVIEW
  OFFER
  REJECTED
}
