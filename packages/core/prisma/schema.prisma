generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // company is only ever queried as ILIKE '%term%' (see VacancyService.list),
  // which a plain b-tree index can't serve — pg_trgm + a GIN index below can.
  extensions = [pg_trgm]
}

model Vacancy {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  company             String
  title               String
  applyUrl            String          @unique
  // Can be large. Kept on the row rather than a 1:1 side table on purpose: Postgres
  // TOASTs large TEXT out-of-line, and every read path except getById projects it
  // out (see LIST_SELECT), so queries that don't need it already don't pay for it.
  fullText            String          @db.Text
  matchScore          Int
  recommendation      Recommendation
  // The user's side: a cache of the latest StatusChange and its date. Written only
  // through writeStatus (status.ts), which keeps the two in step.
  status              VacancyStatus   @default(NOT_REVIEWED)
  statusChangedAt     DateTime        @default(now())
  // What was entered when applying (the apply modal).
  salaryInListing     String?
  usedTailoredResume  Boolean         @default(false)

  // Every note on the vacancy — the analyzer's reasoning, the user's, an agent's.
  comments            Comment[]
  // Every status the vacancy has been in, with its date.
  statusChanges       StatusChange[]

  @@index([recommendation])
  @@index([status, statusChangedAt])
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  // /applications searches company OR title as ILIKE '%term%' — same reason company has
  // a trigram GIN index, title needs one too.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// One row per status change, append-only. The applied date is the latest APPLIED row's
// createdAt.
model StatusChange {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  status    VacancyStatus
  vacancyId Int
  vacancy   Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, createdAt])
}

// One note on a vacancy, append-only: no edit, no delete. `source` says who wrote it —
// the analyzer's reasoning (written once, with the analysis), the user's, or an agent's
// (MCP). Read oldest first, `id` breaking a tie.
model Comment {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  body      String        @db.Text
  source    CommentSource
  vacancyId Int
  vacancy   Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, createdAt])
}

// Every posting seen before analysis — the dedup log (ADR-0026). Written only through
// VacancyLogService, which normalizes url and derives both keys; a row written any
// other way never matches. `createdAt` is the date the posting was first seen. The url
// is required; company/title can be missing and are filled on a later duplicate.
model VacancyLogEntry {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  url        String   @unique
  company    String?
  title      String?
  companyKey String?
  titleKey   String?

  @@index([companyKey, titleKey])
}

enum Recommendation {
  APPLY
  APPLY_WITH_CAVEATS
  SKIP
}

enum CommentSource {
  ANALYZER
  USER
  AGENT
}

// Triage (NOT_REVIEWED, SAVED_FOR_LATER, DECLINED, UNAVAILABLE), then the pipeline
// (APPLIED … REJECTED — PIPELINE_STATUSES). REJECTED = the company said no; DECLINED = "I
// chose not to apply"; UNAVAILABLE = the posting no longer takes applications.
enum VacancyStatus {
  NOT_REVIEWED
  SAVED_FOR_LATER
  DECLINED
  UNAVAILABLE
  APPLIED
  RECRUITER_SCREEN
  REPLIED
  INTERVIEW
  OFFER
  REJECTED
}
