generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // company is only ever queried as ILIKE '%term%' (see EstimatedVacancyService.list),
  // which a plain b-tree index can't serve — pg_trgm + a GIN index below can.
  extensions = [pg_trgm]
}

model EstimatedVacancy {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  company             String
  title               String
  applyUrl            String          @unique
  // Can be large. Kept on the row rather than a 1:1 side table on purpose: Postgres
  // TOASTs large TEXT out-of-line, and every read path except getById projects it
  // out (see LIST_SELECT), so queries that don't need it already don't pay for it.
  fullText            String          @db.Text
  matchScore          Int
  recommendation      Recommendation
  estimationComment   String          @db.Text
  userAction          UserAction      @default(NOT_REVIEWED)
  userActionUpdatedAt DateTime?

  // Phase 2: the delta recorded when the user actually applied. Absent until then.
  application         Application?

  @@index([recommendation])
  @@index([userAction])
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  // /tracker searches company OR title as ILIKE '%term%' via this relation — same
  // reason company has a trigram GIN index, title now needs one too.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// One row per submitted application. Deliberately minimal: it stores only what the
// analyzer's row can't (status, salary in the listing, whether a tailored CV was
// used, the user's own comment). Company / title / applyUrl / matchScore /
// recommendation / analyzer comment are read from the linked EstimatedVacancy — see
// ADR-0017. Strict 1:1: estimatedVacancyId is unique. A never-analyzed application
// still gets a real EstimatedVacancy row (placeholder analyzer fields) — ADR-0019.
model Application {
  id                 Int               @id @default(autoincrement())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  estimatedVacancyId Int               @unique
  estimatedVacancy   EstimatedVacancy  @relation(fields: [estimatedVacancyId], references: [id], onDelete: Cascade)

  // The real submission date. Distinct from EstimatedVacancy.createdAt (date analyzed);
  // the tracker import backfills historical values here.
  appliedAt          DateTime          @default(now())
  status             ApplicationStatus @default(APPLIED)
  // "When I last moved this in the pipeline" — mirrors userActionUpdatedAt's semantics.
  statusUpdatedAt    DateTime?
  // Accumulated notes about pipeline movement (one per updateStatus() call that
  // passes a comment), appended to the existing value with " / " — not a history
  // table. Simplest thing that works; revisit as a real history if that's ever
  // not enough.
  statusComment      String?           @db.Text

  salaryInListing    String?
  usedTailoredResume Boolean           @default(false)
  userComment        String?           @db.Text

  @@index([status])
  @@index([appliedAt])
}

enum Recommendation {
  APPLY
  APPLY_WITH_CAVEATS
  SKIP
}

enum UserAction {
  NOT_REVIEWED
  READY_TO_APPLY
  APPLIED
  DECLINED
}

// The pipeline stage of a submitted application. Separate axis from UserAction (which
// is triage on an analyzed vacancy) — see ADR-0018. REJECTED = the company said no,
// which is a different thing from UserAction.DECLINED ("I chose not to apply").
enum ApplicationStatus {
  APPLIED
  RECRUITER_SCREEN
  REPLIED
  INTERVIEW
  OFFER
  REJECTED
  NO_RESPONSE
}
