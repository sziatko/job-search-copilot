{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser build: override the base's Node module settings for Vite, and add the
    // DOM libs. `target` and the rest come from tsconfig.base.json.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
